FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY hospital_node/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application and shared module directories
COPY hospital_node/ /app/
COPY shared/ /app/shared/
COPY .proto/ /app/.proto/

# Generate Python bindings for gRPC internally, completely isolating from MacOS filesystem
RUN python -m grpc_tools.protoc -I/app/.proto --python_out=/app/shared --grpc_python_out=/app/shared /app/.proto/corechain.proto

# Hospital dashboard backend
EXPOSE 3000

# Ensure entrypoint has execution rights
RUN chmod +x entrypoint.sh

ENTRYPOINT ["./entrypoint.sh"]
